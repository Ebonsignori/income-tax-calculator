{
  "name": "income-tax-calculator",
  "author": "Evan Bonsignori",
  "description": "An income tax calculator for the United States.",
  "version": "0.0.0",
  "private": false,
  "scripts": {
    "go": "npm run lint:fix && npm run build && node open.js 3001 && npm run start",
    "dev": "node open.js 3001 && next dev -p 3001",
    "dev:test": "NODE_ENV=test next dev -p 3001",
    "build": "next build",
    "postbuild": "next-sitemap && node scripts/update-manifest.js",
    "start": "serve out",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "prepare": "husky",
    "validate-tax-data": "ts-node --project tsconfig.json scripts/validate-tax-data.ts",
    "generate-og-images": "ts-node --project tsconfig.json scripts/generate-og-images.ts",
    "update-dependencies": "ts-node --project tsconfig.json scripts/update-dependencies.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.8",
    "@mui/icons-material": "^5.15.6",
    "@mui/material": "^5.15.6",
    "@mui/material-nextjs": "^5.15.6",
    "@mui/x-charts": "^6.19.1",
    "dinero.js": "^1.9.1",
    "mixpanel-browser": "^2.48.1",
    "next": "v14.1.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/dinero.js": "^1.9.4",
    "@types/mixpanel-browser": "^2.66.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/ui": "^4.0.16",
    "better-opn": "^3.0.2",
    "critters": "^0.0.23",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "joi": "^17.12.1",
    "next-pwa": "^5.6.0",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.2.4",
    "serve": "^14.2.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  }
}
