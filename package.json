{
  "name": "income-tax-calculator",
  "author": "Evan Bonsignori",
  "description": "An income tax calculator for the United States.",
  "version": "0.0.0",
  "private": false,
  "scripts": {
    "go": "npm run lint:fix && npm run build && node open.js 3001 && npm run start",
    "dev": "node open.js 3001 && next dev -p 3001",
    "dev:test": "NODE_ENV=test next dev -p 3001",
    "build": "next build",
    "postbuild": "next-sitemap && node scripts/update-manifest.js",
    "start": "serve out",
    "lint": "next lint --dir src --dir scripts --dir tests",
    "lint:fix": "next lint --fix --dir src --dir scripts --dir tests",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run validate-tax-data && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "prepare": "husky",
    "validate-tax-data": "ts-node --project tsconfig.json scripts/validate-tax-data.ts",
    "generate-og-images": "ts-node --project tsconfig.json scripts/generate-og-images.ts",
    "test:unit:coverage": "vitest run --coverage",
    "start:test": "serve out -l 3001"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.0.8",
    "@mui/icons-material": "^5.15.6",
    "@mui/material": "^5.15.6",
    "@mui/material-nextjs": "^5.15.6",
    "@mui/x-charts": "^6.19.1",
    "dinero.js": "^2.0.2",
    "next": "v14.1.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.27",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.0.16",
    "better-opn": "^3.0.2",
    "critters": "^0.0.23",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "joi": "^17.12.1",
    "jsdom": "^29.1.1",
    "next-pwa": "^5.6.0",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.2.4",
    "serve": "^14.2.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  }
}
